  "rules": {
    "rule-diameter-weight-split": {
      "type": "RULE",
      "scope": "REWIND",
      "status": "ACTIVE",
      "risk": "HIGH",
      "keywords": ["直径一分为二", "分成两卷", "一分为二"],
      "intent": "WEIGHT_SPLIT",
      "parts": 2,
      "ratios": [50, 50],
      "content": "直径一分为二表示成品重量按50%+50%分成两件，不计算等面积，不把直径数值除以二。",
      "targetDiameter": {
        "requiredForCompiledPlan": true,
        "defaultRef": "#/rules/rule-default-target-diameter/constraints",
        "sourceWhenMissing": "DEFAULT",
        "editableBeforeApply": true
      },
      "backendInvariant": "比例和必须为100；目标直径不参与重量比例计算。",
      "source": "business-confirmation-2026-08-15"
    },
    "rule-default-target-diameter": {
      "type": "RULE",
      "scope": "REWIND",
      "status": "ACTIVE",
      "risk": "HIGH",
      "keywords": ["目标直径", "未指定直径", "默认直径"],
      "content": "客户未指定目标直径时，后端注入1200mm；操作员在应用前可以改为1000mm至1350mm范围内的值。",
      "constraints": {
        "value": 1200,
        "unit": "mm",
        "min": 1000,
        "max": 1350,
        "historicalOrdersUnaffected": true
      },
      "source": "business-confirmation-2026-08-15"
    },
    "rule-saw-cut-count": {
      "type": "RULE",
      "scope": "SAW",
      "status": "ACTIVE",
      "risk": "HIGH",
      "keywords": ["切刀", "切几刀", "切2刀", "锯2刀", "平均分"],
      "intent": "SAW_CUTS",
      "content": "切N刀表示N道刀口，生成N+1件，不是生成N件。",
      "widthAlgorithm": {
        "unit": "mm",
        "integerDivision": true,
        "remainderPolicy": "BALANCED_DETERMINISTIC",
        "remainderDirection": "BACK_FIRST_ROUND_ROBIN",
        "businessMeaning": "前件或后件没有业务偏好；固定算法只为保证重放一致，门幅成品数值最多相差1mm。",
        "weightAllocation": "EQUAL_BY_FINISH_COUNT",
        "weightAllocationStatus": "IMPLEMENTED_BACKEND_DETERMINISTIC",
        "businessConfirmed": true,
        "currentImplementation": {
          "classes": [
            "src/main/java/com/paper/mes/processorder/service/SawPlanCalculator.java",
            "src/main/java/com/paper/mes/processorder/service/SawWeightAllocator.java"
          ],
          "finishWeight": "成品可分配重量按展开后的成品件数均分，不按门幅比例分配",
          "trimWeight": "显式TRIM余料保留按门幅比例分配",
          "remainderWeight": "ALLOCATE模式先将未分配门幅对应重量计入成品预算，再按成品件数均分",
          "roundingRemainder": "三位小数商余法，以0.001kg为单位分散到不同成品，任意两件最多相差0.001kg",
          "implemented": true
        },
        "weightRounding": "BALANCED_QUOTIENT_REMAINDER",
        "weightRoundingDetail": "总重量除以成品件数后保留3位小数；舍入余数以0.001kg为单位均匀分散到不同成品，任意两件重量最多相差0.001kg，不允许由最后一件独占尾差。",
        "maxPieceWeightDifferenceKg": 0.001,
        "sumMustEqualOriginalWidth": true
      },
      "examples": [
        { "input": "2000mm切2刀", "finishCount": 3, "outputWidthsMm": [666, 667, 667], "weightAllocation": "EQUAL_BY_FINISH_COUNT", "weightRounding": "BALANCED_QUOTIENT_REMAINDER", "deterministic": true },
        { "input": "2000mm切3刀", "outputWidthsMm": [500, 500, 500, 500] }
      ],
      "source": "business-confirmation-2026-08-15"
    },
    "rule-core-default-3-inch": {
      "type": "RULE",
      "scope": "REWIND",
      "status": "ACTIVE",
      "risk": "HIGH",
      "keywords": ["纸芯", "芯管", "3英寸", "6英寸"],
      "content": "普通复卷客户明确给纸芯时按显式单位转换；未指定纸芯时成品默认使用3英寸纸芯，不继承母卷纸芯作为默认值。客户原话可写入remarkLong，后端仍必须编译到finishCoreDiameter。rewindMode=6同规格复卷除外，必须使用并校验母卷纸芯。",
      "defaultValue": 3,
      "defaultUnit": "inch",
      "defaultSource": "DEFAULT",
      "exception": {
        "when": "rewindMode=6 KEEP_SPEC",
        "behavior": "成品纸芯必须等于母卷纸芯；母卷纸芯缺失时后端阻断，不使用3英寸默认值。",
        "source": "src/main/java/com/paper/mes/processorder/service/impl/ProcessOrderServiceImpl.java:3715-3738"
      },
      "units": ["mm", "inch"],
      "conversion": "1 inch = 25.4 mm",
      "source": "business-confirmation-2026-08-15"
    },
    "rule-diameter-storage-compatibility": {
      "type": "RULE",
      "scope": "REWIND",
      "status": "ACTIVE",
      "risk": "HIGH",
      "keywords": ["直径单位", "毫米存储", "英寸存储", "成品直径"],
      "content": "AI先按显式单位转换为mm，再按现有整数DTO存储契约写回；不能把小于100的mm值直接写入targetDiameter。",
      "storageContract": {
        "field": "segments[].targetDiameter",
        "readerBehavior": "storedDiameterToMm对0<storedValue<100按英寸解释，其余按mm解释。",
        "mmValueBelow100": "只有当mm值可无损表示为整数英寸（mm=25.4*n，n为正整数）时，才存整数英寸n；否则禁止自动编译并转人工澄清。",
        "example": "3 inch -> 76.2mm -> 存3；76mm不能直接存76，否则读取会被解释为76英寸。",
        "mmValueAtLeast100": "存整数mm，按现有DTO舍入规则执行。",
        "coreDiameterIsSeparate": "纸芯使用storedCoreDiameterToMm阈值10，76mm纸芯可直接存76；不能把纸芯规则套到成品直径。默认成品纸芯为3英寸。"
      },
      "source": "src/main/java/com/paper/mes/processorder/calc/RewindWeightCalculator.java"
    },
    "rule-rewind-mode-semantics": {
      "type": "RULE",
      "scope": "REWIND",
      "status": "ACTIVE",
      "risk": "HIGH",
      "keywords": ["改门幅", "改直径", "分层", "多来源", "不下刀", "直接走一遍", "同规格复卷"],
      "content": "复卷模式必须按1至6的既有语义解释，不得只识别多来源模式5；模式1只改门幅，不设置目标直径，模式2/3才要求目标直径，模式6保持母卷直径、门幅和纸芯。",
      "source": "project-plan-section-4.3"
    },
    "rule-label-no-process-step": {
