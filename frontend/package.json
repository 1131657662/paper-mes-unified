{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:dependencies": "knip --dependencies",
    "check:lighthouse": "npm run build && node scripts/run-lighthouse-ci.mjs",
    "openapi:export": "node scripts/export-openapi.mjs",
    "openapi:contract": "node scripts/build-customer-openapi.mjs",
    "openapi:generate": "npm run openapi:export && npm run openapi:contract && orval --config orval.config.ts",
    "openapi:check": "npm run openapi:generate && git -C .. diff --exit-code -- frontend/openapi/customer-readonly.json frontend/src/api/generated/customerReadOnly.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test accessibility.e2e.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:performance": "node scripts/run-process-order-performance.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/pro-provider": "^2.16.2",
    "@ant-design/pro-table": "^3.21.0",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@tanstack/react-query": "^5.101.1",
    "@xyflow/react": "^12.11.1",
    "antd": "^5.29.3",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable": "^4.0.2",
    "react-router": "8.3.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "chrome-launcher": "^1.2.1",
    "knip": "^6.32.0",
    "orval": "^8.24.0",
    "oxlint": "^1.69.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "inquirer": "8.2.7",
    "path-to-regexp": "8.4.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
