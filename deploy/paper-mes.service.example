[Unit]
Description=Paper MES backend
After=network.target mysql.service

[Service]
Type=simple
User=paper-mes
Group=paper-mes
PrivateTmp=true
RuntimeDirectory=paper-mes
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/paper-mes/app
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=SPRING_CONFIG_ADDITIONAL_LOCATION=file:/etc/paper-mes/
EnvironmentFile=/etc/paper-mes/paper-mes.env
ExecStartPre=+/usr/bin/install -d -o paper-mes -g paper-mes -m 0750 /etc/paper-mes/ai-memory
ExecStartPre=+/usr/bin/bash /opt/paper-mes/source/deploy/verify-paper-mes-source.example.sh
ExecStartPre=+/usr/bin/bash /usr/local/bin/verify-paper-mes-migration-state
ExecStart=/usr/bin/java -Djava.io.tmpdir=/run/paper-mes -Xms256m -Xmx768m -jar /opt/paper-mes/app/paper-mes.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/paper-mes/stdout.log
StandardError=append:/var/log/paper-mes/stderr.log

[Install]
WantedBy=multi-user.target
