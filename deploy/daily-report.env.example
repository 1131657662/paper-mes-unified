# Install as /etc/paper-mes/daily-report.env with mode 0600 and owner root.
# Email addresses and scheduling behavior remain server-side configuration.
REPORT_EMAIL_FROM=sender@example.com
REPORT_EMAIL_TO=receiver@example.com
RETRY_DELAY_SECONDS=600
RETENTION_DAYS=35
CPU_SAMPLE_SECONDS=1
MAX_BACKUP_AGE_HOURS=48

# Space-separated systemd units and journal sources included in the report.
REPORT_SYSTEMD_UNITS="nginx.service mysql.service docker.service paper-mes.service paper-mes-test.service pm2-root.service"
REPORT_ERROR_UNITS="nginx paper-mes paper-mes-test mysql docker pm2-root"
REPORT_PM2_PROCESSES="wms-backend warehouse-api"
