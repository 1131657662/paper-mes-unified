# Install as /etc/paper-mes/server-monitor.env with mode 0600 and owner root.
# The defaults in monitor-server cover the current shared production server.
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_SECONDS=5
CERT_MIN_DAYS=21
MAX_LOAD_PER_CPU=2
MIN_MEMORY_AVAILABLE_PERCENT=10
MAX_DISK_USED_PERCENT=85
MAX_INODE_USED_PERCENT=85
MAX_BACKUP_AGE_HOURS=48
MAX_REMOTE_SYNC_AGE_HOURS=48
MAX_CHECK_FILE_AGE_HOURS=48
REMINDER_HOURS=2

# Keep secrets only in this server-side file. Leave empty when unused.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
ALERT_EMAIL_COMMAND=/usr/local/bin/send-paper-mes-alert-email

# Healthchecks.io success-ping URL. Keep the UUID secret and server-side only.
DEAD_MAN_SWITCH_URL=
INTERNAL_FAILURE_COMMAND=/usr/local/sbin/notify-server-monitor-internal
INTERNAL_FAILURE_REMINDER_HOURS=2
