# Copy to /etc/paper-mes/paper-mes.env and chmod 600.
# Keep real credentials outside the repository.
PAPER_MES_DB_USER=paper_mes_app
PAPER_MES_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
PAPER_MES_AI_MEMORY_DIR=/etc/paper-mes/ai-memory
# Required before enabling AI process conversations: Base64-encoded 32-byte AES key.
PAPER_MES_AI_MESSAGE_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
PAPER_MES_AI_CONFIG_MASTER_KEY=CHANGE_ME_DIFFERENT_BASE64_32_BYTE_KEY
PAPER_MES_AI_MEMORY_REFERENCE_HMAC_KEY=CHANGE_ME_STABLE_HMAC_KEY
# POC route: set provider/data mode explicitly after accepting cloud data terms.
PAPER_MES_AI_PROVIDER=DEEPSEEK
PAPER_MES_AI_DATA_MODE=CONTEXT_ALLOWLIST
# Keep disabled until collaborative dialogue v2 passes staged acceptance.
PAPER_MES_AI_PROCESS_DIALOGUE_V2=false
PAPER_MES_AI_PROCESS_DIALOGUE_V2_ORDERS=
PAPER_MES_AI_PROCESS_DIALOGUE_V2_USERS=
PAPER_MES_AI_DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
PAPER_MES_AI_DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# Optional fallback used only when DeepSeek fails before emitting any content.
PAPER_MES_AI_ZHIPU_API_KEY=
PAPER_MES_AI_ZHIPU_MODEL=glm-4.7-flash
PAPER_MES_AI_ZHIPU_BASE_URL=https://open.bigmodel.cn
PAPER_MES_AI_ZHIPU_CONNECT_TIMEOUT_MS=1000
PAPER_MES_AI_ZHIPU_READ_TIMEOUT_MS=8000
PAPER_MES_AI_ZHIPU_MAX_OUTPUT_TOKENS=1000
PAPER_MES_AI_PROVIDER_MAX_ATTEMPTS=2
PAPER_MES_AI_PROVIDER_RETRY_BACKOFF_MS=250
PAPER_MES_AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PAPER_MES_AI_PROVIDER_CIRCUIT_OPEN_SECONDS=30
PAPER_MES_AI_CONVERSATION_CLEANUP_DELAY_MS=60000
PAPER_MES_AI_DEFAULT_TARGET_DIAMETER_MM=1200
PAPER_MES_AI_MEMORY_CANDIDATE_MIN_ORDERS=5
PAPER_MES_AI_MEMORY_CANDIDATE_WINDOW_DAYS=7
PAPER_MES_AI_MEMORY_CANDIDATE_TTL_DAYS=90
PAPER_MES_AI_MEMORY_EVIDENCE_AUDIT_RETENTION_DAYS=90
PAPER_MES_AI_MEMORY_LEARNING_PROCESSING_TIMEOUT_MINUTES=10
PAPER_MES_SCHEMA_BOOTSTRAP_ENABLED=false
PAPER_MES_EXPECTED_SCHEMA_VERSION=3.76
PAPER_MES_BACKEND_VERSION=CHANGE_ME_RELEASE_VERSION
PAPER_MES_FRONTEND_VERSION=CHANGE_ME_RELEASE_VERSION
PAPER_MES_GIT_SHA=CHANGE_ME_GIT_SHA
PAPER_MES_BUILD_TIME=CHANGE_ME_UTC_BUILD_TIME
# Optional Linux-only isolated restore verification wrapper.
# Enable only after installing the root-owned wrapper and sudoers rule.
PAPER_MES_BACKUP_VERIFY_WRAPPER=
APP_INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
APP_INITIAL_OPERATOR_PASSWORD=CHANGE_ME_STRONG_OPERATOR_PASSWORD
