# Root-only credentials for isolated restore verification.
# Install as /etc/paper-mes/backup-restore.env with root:root 0600.
# Do not reuse the application account or put this file in the repository.
# The wrapper fixes the backup root, restore database, lock, report path and
# cleanup policy; none of those security boundaries are configurable here.

SOURCE_DB_NAME=paper_processing
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=3306
DB_ADMIN_USER=paper_mes_restore
DB_ADMIN_PASSWORD=CHANGE_ME_RESTORE_PASSWORD
